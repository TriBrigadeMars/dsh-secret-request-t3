{
  "compilerOptions": {
    "lib": ["ES2025", "ESNext.Collection", "ESNext.Temporal", "DOM"],
    "module": "NodeNext",
    "target": "ES2025",
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tsdown.config.ts"]
}
